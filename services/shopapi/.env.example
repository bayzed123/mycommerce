# Django settings

DEBUG=

SECRET_KEY=

# Comma-separated. Must include the real hostname(s) this service is
# served on in production (e.g. Railway's *.up.railway.app domain or a
# custom domain), or Django returns "Bad Request (400)" for every request.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins (with scheme) allowed to make CORS/CSRF-protected
# requests, e.g. the deployed storefront's URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8007

CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:8007

# Redis settings

REDIS_HOST=''

REDIS_PASSWORD=''

# RabbitMQ settings

RABBITMQ_HOST=''

RABBITMQ_USER=''

RABBITMQ_PASSWORD=''

# Stripe

STRIPE_TEST_SECRET_KEY=''

STRIPE_PRODUCTION_SECRET_KEY=''

# PostgreSQL settings

DB_NAME='mystore'

DB_USER=''

DB_PASSWORD=''

DB_HOST=''

# JWT settings

PY_UTILITIES_JWT_ISSUER=''

PY_UTILITIES_JWT_SECRET=''

# Other

VAT_PERCENTAGE=

# AWS

USE_S3=False

AWS_S3_BUCKET_NAME=''

AWS_S3_REGION_NAME=''

AWS_S3_ACCESS_KEY_ID=''

AWS_S3_SECRET_ACCESS_KEY=''

AWS_STORAGE_BUCKET_NAME=''

# Microservices

MICROSERVICES=

GOLANG_ROUTER=

# N8N

N8N_API_URL=

N8N_TEST_API_URL=

