DEBUG=

SECRET_KEY=''

# Comma-separated. Must include the real hostname(s) this service is
# served on in production, or Django returns "Bad Request (400)" for
# every request.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins (with scheme) allowed to make CORS/CSRF-protected
# requests, e.g. the deployed storefront's URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000

CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Redis Configuration

REDIS_HOST='localhost'

REDIS_PASSWORD=''

# RabbitMQ Configuration

RABBITMQ_HOST='localhost'

RABBITMQ_USER='guest'

RABBITMQ_PASSWORD='guest'

# JWT Secret Key

PY_UTILITIES_JWT_ISSUER='cartapi'

PY_UTILITIES_JWT_SECRET='supersecretkey'

# Database configuration

DB_NAME='mycart'

DB_USER=''

DB_PASSWORD=''

DB_HOST='localhost'

# Stripe Configuration

STRIPE_PRODUCTION_API_KEY=''

STRIPE_TEST_SECRET_KEY=''
